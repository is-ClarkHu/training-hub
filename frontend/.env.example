# Frontend env (Vite) — copy to .env.local and fill in.
# The anon key is browser-safe by design (RLS enforces per-user isolation).
# NEVER put the service-role key or the Claude API key here. See SPEC §13/§14.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Phase-2 assistant backend (FastAPI). Leave unset for local default :8000.
VITE_ASSISTANT_API_URL=
