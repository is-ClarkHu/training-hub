# Backend env — PHASE 2 (the minimal FastAPI for /api/assistant).
# Secrets live here, never in the frontend, never in git. See SPEC §9/§13.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=          # the anon key (requests are RLS-scoped via the user's JWT)
# Optional:
FRONTEND_ORIGIN=*      # set to your frontend origin in production
ASSISTANT_MODEL=claude-opus-4-8
